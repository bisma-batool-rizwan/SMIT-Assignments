#Q1 — Online Food Delivery System 
print("==========Q1 — Online Food Delivery System ==========")
foods = ["Burger", "Pizza", "Fries", "Broast", "Sandwich"]
print("First Food Item  :  ",foods[0])
print("Last Food item  :  ",foods[-1])
foods[2] = "Pasta"
foods.append("Zinger")
foods.insert(2,"Shawarma")
foods.remove("Pizza")
foods.pop(-1)
print(len(foods))
print(foods[0:3])
